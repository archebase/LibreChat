# Network
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=https://chat.archebase.ai
DOMAIN_SERVER=https://chat.archebase.ai
NO_INDEX=true
TRUST_PROXY=1
BIND_IP=127.0.0.1
CHAT_DOMAIN=chat.archebase.ai

# Datastores
MONGO_URI=mongodb://mongodb:27017/LibreChat
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=change-me
SEARCH=true

# App secrets
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
CREDS_KEY=change-me-32-byte-hex
CREDS_IV=change-me-16-byte-hex

# Branding
APP_TITLE=ArcheBase
CUSTOM_FOOTER=ArcheBase

# Auth: SSO only via ArcheGate OIDC
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
OPENID_ISSUER=https://gate.archebase.ai
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=change-me
OPENID_SESSION_SECRET=change-me
OPENID_SCOPE=openid
OPENID_CALLBACK_URL=https://chat.archebase.ai/oauth/openid/callback
OPENID_BUTTON_LABEL=ArcheBase Login
OPENID_AUTO_REDIRECT=true

# ArcheBase AIFlow impersonation sidecar
OIDC_SCOPE=openid
FALLBACK_SUB=1
AIFLOW_UPSTREAM=https://aiflow.archebase.ai/llm

# Deployment image
LIBRECHAT_IMAGE_TAG=archebase
